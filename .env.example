# Variáveis do docker-compose.yml. Copie para .env e preencha.

# Segredos do JWT (obrigatórios). Gere valores aleatórios com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Banco (opcional; padrão helios/helios/helios)
# POSTGRES_USER=helios
# POSTGRES_PASSWORD=helios
# POSTGRES_DB=helios

# Porta do app no seu computador (opcional; padrão 8080)
# WEB_PORT=8080

# Endereço pelo qual o app é acessado (opcional; padrão http://localhost:8080)
# APP_URL=http://localhost:8080

# "true" quando o app estiver atrás de HTTPS (opcional; padrão false)
# COOKIE_SECURE=false
