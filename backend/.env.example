NODE_ENV=development
PORT=3333

# Mesmo usuário/senha/banco do docker-compose.yml
DATABASE_URL="postgresql://helios:helios@localhost:5432/helios?schema=public"

# Gere valores aleatórios com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-com-pelo-menos-32-caracteres

# Origem do futuro frontend React (Vite usa 5173 por padrão)
CORS_ORIGIN=http://localhost:5173
